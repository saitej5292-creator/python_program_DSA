    "def tribonacci(n):\n",
    "    a, b, c = 0, 1, 1\n",
    "    if n == 0:\n",
    "        return a\n",
    "    if n == 1:\n",
    "        return b\n",
    "    if n == 2:\n",
    "        return c\n",
    "\n",
    "    for _ in range(3, n + 1):\n",
    "        a, b, c = b, c, a + b + c\n",
    "    return c\n",
    "\n",
