    "\n",
    "        if r < 0 or r >= rows or c < 0 or c >= cols:\n",
    "            return False\n",
    "\n",
    "        if board[r][c] != word[i]:\n",
    "            return False\n",
    "\n",
    "        temp = board[r][c]\n",
    "        board[r][c] = \"#\"\n",
    "\n",
    "        found = (\n",
    "            dfs(r + 1, c, i + 1) or\n",
    "            dfs(r - 1, c, i + 1) or\n",
    "            dfs(r, c + 1, i + 1) or\n",
    "            dfs(r, c - 1, i + 1)\n",
    "        )\n",
    "\n",
    "        board[r][c] = temp\n",
    "        return found\n",
