    "def generate_parentheses(n):\n",
    "    result = []\n",
    "\n",
    "    def backtrack(s, open_count, close_count):\n",
    "        if len(s) == 2 * n:\n",
    "            result.append(s)\n",
    "            return\n",
    "\n",
    "        if open_count < n:\n",
    "            backtrack(s + \"(\", open_count + 1, close_count)\n",
    "\n",
    "        if close_count < open_count:\n",
    "            backtrack(s + \")\", open_count, close_count + 1)\n",
    "\n",
