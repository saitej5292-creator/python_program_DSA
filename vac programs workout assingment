    "    def backtrack(r, c, path):\n",
    "        if r == n - 1 and c == n - 1:\n",
    "            result.append(path)\n",
    "            return\n",
    "\n",
    "        if r < 0 or c < 0 or r >= n or c >= n:\n",
    "            return\n",
