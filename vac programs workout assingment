    "    if n == 1:\n",
    "        return 0\n",
    "\n",
    "    mid = 2 ** (n - 2)\n",
    "\n",
    "    if k <= mid:\n",
    "        return kth_symbol(n - 1, k)\n",
    "    return 1 - kth_symbol(n - 1, k - mid)\n",
